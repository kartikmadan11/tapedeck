# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# test output
coverage/
.vitest/

# local environment
.env
.env.*
!.env.example
*.local

# briefs, exports, anything printed
*.pdf

# raw transcript extract, source material for docs/prompt-log.md
docs/prompt-log-raw.md

# tooling caches
.vite/
.turbo/

# editor and OS
# ~$ files are the owner locks Word leaves beside an open .docx
~$*
# settings.json is in, because it is the project's formatter and not a personal
# preference: without it an editor formats to its own defaults and fights Biome.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store

# logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
