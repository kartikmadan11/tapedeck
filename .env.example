# Every value here is a default that docker compose already applies, so
# `docker compose up --build` works with no .env file at all. Copy this to .env
# only to change one of them.

# --- docker compose ---
POSTGRES_USER=tapedeck
POSTGRES_PASSWORD=tapedeck
POSTGRES_DB=tapedeck

# Host port for the application. The container always listens on 3000.
PORT=3000
LOG_LEVEL=info

# --- running the api on the host instead ---
# The compose database is published on 5433, so a host process uses that port
# while the api container uses db:5432.
# DATABASE_URL=postgres://tapedeck:tapedeck@localhost:5433/tapedeck

# The integration tests truncate every table, so they need their own database:
#   createdb -h localhost -p 5433 -U tapedeck tapedeck_test
# TEST_DATABASE_URL=postgres://tapedeck:tapedeck@localhost:5433/tapedeck_test

# Absolute path to the built frontend. Unset in development, where Vite serves
# the assets and proxies /api and /ws to this process.
# STATIC_DIR=/app/frontend/dist

# --- the generated trade feed ---
# Books, amends and cancels trades on a timer through the same service calls the
# REST routes use, so the blotter is live from first paint without anyone
# clicking. On by default; the header toggle stops it for every connected window.
# Set this to exactly "false" to start with it off.
# SIMULATION_ENABLED=false
# SIMULATION_INTERVAL_MS=2000

# Active-trade ceiling. At this point the feed stops booking and only amends and
# cancels, so a long session stays near the 100-to-1,000 rows the brief asks for.
# SIMULATION_MAX_TRADES=900
