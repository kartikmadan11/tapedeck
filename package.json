{
  "name": "tapedeck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time equity trade blotter",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "shared",
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run lint:palette && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "lint:palette": "if grep -rnE 'zinc-|indigo-|emerald-|rose-|#[0-9a-fA-F]{6}' frontend/src --include='*.tsx'; then echo 'palette: use a tape-* token, not a raw colour' && exit 1; fi",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspace @tapedeck/frontend",
    "dev:api": "npm run dev --workspace @tapedeck/backend",
    "dev:web": "npm run dev --workspace @tapedeck/frontend",
    "db:generate": "npm run generate --workspace @tapedeck/database",
    "db:migrate": "npm run migrate --workspace @tapedeck/database",
    "db:seed": "npm run seed --workspace @tapedeck/database",
    "start": "npm run start --workspace @tapedeck/backend"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
